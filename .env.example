# Copy this file to .env and fill in real values. Never commit .env.

# --- Identity ---
ASSISTANT_NAME=Jarvis

# --- LLM provider ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1024

# --- Conversation ---
MAX_HISTORY_MESSAGES=20

# --- Paths ---
JARVIS_DATA_DIR=data

# --- Logging ---
LOG_LEVEL=INFO
JARVIS_DEBUG=false

# --- Voice (Phase 5, optional — only used if you run /voice) ---
WHISPER_MODEL_SIZE=base
TTS_VOICE=en-GB-RyanNeural
# Relative adjustments edge-tts accepts as strings, e.g. "-10%", "+5%", "+2Hz".
# Calm, measured British delivery — closest available stand-in for a
# JARVIS-inspired tone without cloning any actor's actual voice. Try
# other options with:
#   edge-tts --list-voices
TTS_RATE=-10%
TTS_PITCH=-2Hz

# Wake word detection sensitivity (0.0-1.0, lower = catches more but more
# false positives). The pretrained model was trained on "hey jarvis"
# specifically; plain "jarvis" alone may work but less reliably even at
# a lower threshold — see README for details.
WAKE_WORD_THRESHOLD=0.4

# Cinematic voice post-processing: a subtle high-frequency shelf boost
# (crispness) plus a faint low-rate amplitude modulation (metallic
# texture), applied on top of whatever TTS_VOICE/RATE/PITCH produce.
# Requires ffmpeg to be installed and on PATH (pydub uses it to decode/
# re-encode audio) — see README for install instructions. If ffmpeg isn't
# available, this silently falls back to unprocessed playback rather than
# failing the response.
TTS_CINEMATIC_EFFECT=true
TTS_EFFECT_BOOST_HZ=7000
TTS_EFFECT_BOOST_DB=1.5
TTS_EFFECT_MOD_HZ=50
TTS_EFFECT_MOD_DEPTH=0.05

# --- Weather & News (Phase 7) ---
WEATHER_TEMP_UNIT=fahrenheit
# Comma-separated RSS feed URLs. Defaults to BBC World + Reuters top news.
NEWS_FEED_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.reutersagency.com/feed/?best-topics=top-news

# --- Calendar & Email (Google, optional) ---
# Only used if credentials.json exists at the path below. See README for
# how to obtain one via Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=data/google_token.json

# --- Computer control & file intelligence (Phase 8) ---
# Comma-separated list of directories Jarvis is allowed to read/write/open
# within. Nothing outside these is ever accessible. Example for Windows:
ALLOWED_DIRECTORIES=D:\jarvis,D:\Users\tarun\Documents

# name=executable pairs. Only these names can be opened via open_application.
ALLOWED_APPLICATIONS=notepad=notepad.exe,calculator=calc.exe,explorer=explorer.exe,vscode=code

# project_path=test command pairs (space-separated command). Only projects
# listed here can have their tests run via run_tests.
PROJECT_TEST_COMMANDS=D:\jarvis=python -m pytest -q
