# Copy this file to .env and fill in real values. Never commit .env.

# --- Identity ---
ASSISTANT_NAME=Jarvis
# How Jarvis should address you (optional), e.g. "sir" or your first name.
USER_NAME=

# --- LLM provider ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Thinking counts toward this limit; keep it generous or replies get cut off.
CLAUDE_MAX_TOKENS=16000
# How hard Claude thinks: low | medium | high | xhigh | max.
# low = fastest/cheapest, high = best for complicated multi-step tasks.
CLAUDE_EFFORT=medium
# Server-side web search + page fetching (billed per search by Anthropic).
WEB_SEARCH_ENABLED=true
# Max tool round-trips per request (multi-step automations need room).
MAX_TOOL_ITERATIONS=25

# --- Paths ---
JARVIS_DATA_DIR=data

# --- Logging ---
LOG_LEVEL=WARNING
JARVIS_DEBUG=false

# --- System access ---
# run_shell_command runs PowerShell. EVERY command is shown to you and only
# runs after you type "yes"; set false to remove the tool entirely.
SHELL_ENABLED=true
SHELL_TIMEOUT_SECONDS=120
# Desktop toast notifications for reminders and scheduled tasks.
DESKTOP_NOTIFICATIONS=true

# --- Browser automation (pip install -e ".[browser]") ---
# Uses Microsoft Edge with its own profile in data/browser_profile.
BROWSER_HEADLESS=false

# --- Voice (optional — only used by /voice, /wake and /speak) ---
# Voice engine: "edge" = Microsoft's natural online voice (starts ~0.5-1s
# after the reply); "piper" = offline voice (instant, but more synthetic).
TTS_ENGINE=edge
# Offline (piper) voice, in data/piper. Download others with:
#   python -m piper.download_voices --download-dir data/piper <voice-name>
PIPER_VOICE=en_GB-alan-medium
WHISPER_MODEL_SIZE=base
# Spoken language ("en", "hi", ...) or "auto" to detect it each time.
WHISPER_LANGUAGE=en
# How long a pause (seconds) ends a spoken sentence in /wake mode.
VOICE_SILENCE_SECONDS=0.8
TTS_VOICE=en-GB-RyanNeural
# Relative adjustments edge-tts accepts as strings, e.g. "-10%", "+5%", "+2Hz".
# Try other voices with: edge-tts --list-voices
TTS_RATE=-5%
TTS_PITCH=-2Hz

# Wake word sensitivity (0.0-1.0, lower = reacts to more "hey jarvis"-like
# sounds, but more false alarms). Run /wakecheck in Jarvis to tune it.
WAKE_WORD_THRESHOLD=0.3
# Software microphone boost for wake-word detection (2.0 for a quiet mic).
WAKE_WORD_GAIN=1.0

# "Film AI" voice treatment: a clarity/presence boost plus faint short
# room reflections. Set TTS_CINEMATIC_EFFECT=false for the plain voice.
# TTS_EFFECT_MOD_DEPTH adds a metallic wobble (0.02-0.05); it sounds robotic,
# so it's off by default.
TTS_CINEMATIC_EFFECT=true
TTS_EFFECT_BOOST_HZ=3500
TTS_EFFECT_BOOST_DB=2.0
TTS_EFFECT_ROOM=0.12
TTS_EFFECT_MOD_HZ=50
TTS_EFFECT_MOD_DEPTH=0

# --- Weather & News ---
# fahrenheit (wind in mph) or celsius (wind in km/h)
WEATHER_TEMP_UNIT=fahrenheit
# Comma-separated RSS feed URLs.
NEWS_FEED_URLS=https://feeds.bbci.co.uk/news/world/rss.xml,https://feeds.npr.org/1001/rss.xml

# --- Calendar & Email (Google, optional) ---
# Only used if credentials.json exists at the path below. See README.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=data/google_token.json

# --- Files & apps ---
# Folders the file tools may read/write within. Nothing outside these is
# reachable through the file tools (the confirmed shell is the escape hatch).
# %USERPROFILE% and ~ are expanded.
ALLOWED_DIRECTORIES=%USERPROFILE%\Documents,%USERPROFILE%\Downloads,%USERPROFILE%\Desktop

# name=executable pairs that open without confirmation. Any other app can
# still be opened, but Jarvis asks you first.
ALLOWED_APPLICATIONS=notepad=notepad.exe,calculator=calc.exe,explorer=explorer.exe,vscode=code

# project_path=test command pairs. Only projects listed here can have their
# tests run via run_tests.
PROJECT_TEST_COMMANDS=D:\jarvis=python -m pytest -q
